# نسخ هذا الملف إلى .env وضبط القيم
# Copy this file to .env and adjust the values

# مفتاح جلسات المستخدمين — عشوائي بطول 32+ حرفاً. إلزامي في الإنتاج.
# Session signing secret — random, 32+ chars. REQUIRED in production.
# أنشئه بـ: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# مفتاح CSRF إضافي (اختياري — غير مستخدم حالياً في الكود)
CSRF_SECRET=

# منفذ الخادم
PORT=3001

# حد الطلبات في الدقيقة (API العام / تسجيل الدخول)
RATE_LIMIT_API=3000
RATE_LIMIT_LOGIN=30

# في وضع PostgreSQL: أضف
# DATABASE_URL=postgres://user:pass@host:5432/bloodbank

# في وضع Redis لجلسات متعددة النسخ: أضف
# REDIS_URL=redis://localhost:6379

# إظهار تفاصيل الأخطاء (منخفض — فقط للتطوير)
# SHOW_ERROR_DETAILS=true
